set -euo pipefail

# Brackets are used around characters so these don't show up in normal search.
pattern='tod[o]!|FIXM[E]'
result=$(git grep --no-color --ignore-case --line-number --extended-regexp -e "$pattern" || true)
if [[ -n "${result}" ]]; then
  echo "${result}"
  exit 1
fi
