#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 José García "Ruxwez" (Rixu Industries)

set -euo pipefail

if [[ ! " $* " == *" -p "* && ! " $* " == *" --package "* ]]; then
    set -- "$@" --workspace
fi

set -x
"${CARGO:-cargo}" clippy "$@" --all-targets --all-features --locked -- --deny warnings

# If local, run other checks if we have the tools installed.
if [[ -z "${GITHUB_ACTIONS+x}" ]]; then
    which cargo-shear >/dev/null 2>&1 || exit 0
    cargo shear --locked --deny-warnings --check-test-targets

    which typos >/dev/null 2>&1 || exit 0
    typos --config .config/typos.toml
fi
